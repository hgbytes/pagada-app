# Supabase Configuration
# Get these values from your Supabase project settings at https://app.supabase.com

REACT_APP_SUPABASE_URL=your_supabase_url_here
REACT_APP_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Telegram Configuration (Backend/Edge Function)
# Set these in Supabase project settings → Edge Functions secrets
# Get bot token from @BotFather on Telegram
# Get chat ID by sending a message to your bot and getting the chat_id from /getUpdates

TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
