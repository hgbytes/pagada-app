{
  "kind": "collectionType",
  "collectionName": "blogs",
  "info": {
    "singularName": "blog",
    "pluralName": "blogs",
    "displayName": "Blog"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "Title": {
      "type": "string",
      "minLength": 3,
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "Title"
    },
    "author": {
      "type": "string"
    },
    "published": {
      "type": "datetime"
    },
    "media": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "excerpt": {
      "type": "text"
    },
    "content": {
      "type": "blocks"
    }
  }
}
