# Production Environment Variables for PAGADA
# This file should be created locally (NOT committed to Git)
# Add this file to .gitignore to prevent exposing secrets

# Supabase Production Credentials
REACT_APP_SUPABASE_URL=your_production_supabase_url_here
REACT_APP_SUPABASE_ANON_KEY=your_production_anon_key_here

# Strapi Production URL (if using Strapi CMS)
REACT_APP_STRAPI_URL=your_production_strapi_url_here

# Optional: Analytics & Monitoring
# REACT_APP_GOOGLE_ANALYTICS_ID=your_ga_id
# REACT_APP_SENTRY_DSN=your_sentry_dsn
